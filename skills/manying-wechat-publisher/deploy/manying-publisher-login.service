[Unit]
Description=Normal interactive WeChat login on private server desktop
Requires=manying-publisher-desktop.service
After=manying-publisher-desktop.service

[Service]
Type=oneshot
User=manying-publisher
Group=manying-publisher
Environment=HOME=/var/lib/manying-publisher
Environment=DISPLAY=:97
Environment=XAUTHORITY=/var/lib/manying-publisher/.Xauthority
Environment=MANYING_RPA_PROFILE=/var/lib/manying-publisher/rpa-profile
Environment=MANYING_RPA_CHANNEL=chromium
Environment=MANYING_RPA_PROXY=http://127.0.0.1:17897
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/manying-publisher/browsers
ExecStart=/opt/manying-publisher/venv/bin/python /opt/manying-publisher/current/workspace/skills/manying-wechat-publisher/scripts/server_login.py --config /etc/manying-publisher/publisher.json
TimeoutStartSec=31min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/manying-publisher /tmp
InaccessiblePaths=/etc/manying /var/lib/manying /opt/manying
MemoryHigh=700M
MemoryMax=1050M
MemorySwapMax=512M
TasksMax=256

